# ---- 必填：缺失即启动失败（pydantic-settings 启动校验） ----
# 逗号分隔的 API Key 列表，全 API 与 WS 握手凭据
API_KEYS=dev-local-key

# ---- 数据库 / 缓存 ----
# 本地开发默认 SQLite；生产指向 PostgreSQL 16
DATABASE_URL=sqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0

# ---- AI（OpenAI 兼容接口，M2 流水线使用；缺失时走 R-207 降级，不阻塞启动） ----
# 默认接 OpenAI 官方；换 DeepSeek/通义/OpenRouter/自建 vLLM 只改这三项
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Twitter 第三方 API（M2 使用；缺失时该源标记不可用） ----
TWITTER_API_KEY=

# ---- SMTP（M2 邮件通知；未配置时静默跳过，FR-5.1） ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
