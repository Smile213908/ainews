# ---- 必填：缺失即启动失败（pydantic-settings 启动校验） ----
# 逗号分隔的 API Key 列表，全 API 与 WS 握手凭据
API_KEYS=dev-local-key

# ---- 运行环境：development（默认）/ production ----
APP_ENV=development

# ---- 数据库 / 缓存 ----
# 方式一（推荐，开发默认）：不配 DATABASE_URL，由下列组件自动拼装，
#   指向 scripts/dev-deps.ps1 拉起的 docker compose PostgreSQL + Redis。
#   改这里即可连接任何已有的 PG / Redis 实例（含 docker 已部署的）。
DB_HOST=localhost
DB_PORT=5432
DB_USER=hotmonitor
DB_PASSWORD=hotmonitor
DB_NAME=hotmonitor
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 方式二：显式完整 URL，优先级高于组件拼装（生产环境 APP_ENV=production 必须显式配置）
# DATABASE_URL=postgresql+psycopg://hotmonitor:hotmonitor@localhost:5432/hotmonitor
# REDIS_URL=redis://localhost:6379/0

# ---- AI（OpenAI 兼容接口，M2 流水线使用；缺失时走 R-207 降级，不阻塞启动） ----
# 默认接 OpenAI 官方；换 DeepSeek/通义/Kimi/自建 vLLM 只改这三项
AI_BASE_URL=https://api.kimi.com/coding/v1
AI_API_KEY=sk-kimi-8XYhj4J4aTsgAG2YhmN3bHDzEWJKw6lIe596DGqcF1jFLQ6BkQOOAugFrODw2BGo
AI_MODEL=k3-256k

# ---- Twitter 第三方 API（M2 使用；缺失时该源标记不可用） ----
TWITTER_API_KEY=

# ---- SMTP（M2 邮件通知；未配置时静默跳过，FR-5.1） ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
