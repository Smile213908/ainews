# 全栈部署环境变量（docker compose 使用）
# 复制为 .env 后填写

# 必填：API 凭据（逗号分隔多个）
API_KEYS=
# 必填：前端 BFF 使用的单个 Key，取 API_KEYS 的第一个
WEB_API_KEY=

# ---- 运行环境：compose 全栈部署固定为 production ----
APP_ENV=production

# ---- 数据库 / 缓存（compose 内 db/redis 服务）----
# DB_PASSWORD 同时用于创建 db 容器和 api 连接串；改端口可避免与本机已有实例冲突
DB_PASSWORD=hotmonitor
DB_PORT=5432
REDIS_PORT=6379

# 连接外部已有 PG / Redis（不用 compose 内置 db/redis 时，取消注释并改为完整 URL，
# 同时在 compose 里给 api 服务覆盖 DATABASE_URL / REDIS_URL）
# DATABASE_URL=postgresql+psycopg://user:password@your-pg-host:5432/hotmonitor
# REDIS_URL=redis://your-redis-host:6379/0

# 部署域名（本地/内网用 :80 即可；公网填域名自动签 HTTPS）
DOMAIN=:80

# ---- 可选：AI / Twitter / SMTP（缺失走降级行为，见 PRD R-207/FR-5.1） ----
# AI 为 OpenAI 兼容三元组：官方默认，换 Provider 只改这三项
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
TWITTER_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
