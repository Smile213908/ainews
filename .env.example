# 全栈部署环境变量（docker-compose --profile prod 使用）
# 复制为 .env 后填写

# 必填：API 凭据（逗号分隔多个）
API_KEYS=

# 数据库密码（compose 内 db/api 共用）
DB_PASSWORD=hotmonitor

# 部署域名（本地/内网用 :80 即可；公网填域名自动签 HTTPS）
DOMAIN=:80

# ---- 可选：AI / Twitter / SMTP（缺失走降级行为，见 PRD R-207/FR-5.1） ----
# AI 为 OpenAI 兼容三元组：官方默认，换 Provider 只改这三项
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
TWITTER_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
